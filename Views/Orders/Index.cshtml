@model IEnumerable<projekt_.NET_schronisko.Models.Orders>

<h2>Przeglądaj Zamówienia</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Data zamówienia</th>
            <th>Status</th>
            <th>Produkty</th>
            <th>Opcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.DataZamowienia</td>
                <td>
                    <span class="badge @(order.Status == "Nowe" ? "bg-warning" : order.Status == "Realizowane" ? "bg-info" : order.Status == "Zrealizowane" ? "bg-success" : "bg-danger")">
                        @order.Status
                    </span>
                </td>
                <td>
                    <ul>
                        @foreach (var orderProduct in order.ProduktyZamowienia)
                        {
                            <li>@orderProduct.Product.Name - Ilość: @orderProduct.Ilosc</li>
                        }
                    </ul>
                </td>
                <td>
                    <a href="@Url.Action("UpdateStatus", "Orders", new { id = order.Id, newStatus = "Realizowane" })" class="btn btn-info btn-sm">W realizacji</a>
                    <a href="@Url.Action("UpdateStatus", "Orders", new { id = order.Id, newStatus = "Zrealizowane" })" class="btn btn-success btn-sm">Zrealizowane</a>
                    <a href="@Url.Action("UpdateStatus", "Orders", new { id = order.Id, newStatus = "Anulowane" })" class="btn btn-danger btn-sm">Anulowane</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<form method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label for="sortBy" class="form-label">Sortuj według:</label>
        <select name="sortBy" class="form-select">
            <option value="">Wybierz...</option>
            <option value="date_asc">Data (od najstarszych)</option>
            <option value="date_desc">Data (od najnowszych)</option>
            <option value="total_asc">Suma (rosnąco)</option>
            <option value="total_desc">Suma (malejąco)</option>
        </select>
    </div>

    <div class="col-md-4">
        <label for="statusFilter" class="form-label">Status zamówienia:</label>
        <select name="statusFilter" class="form-select">
            <option value="">Wszystkie</option>
            <option value="Nowe">Nowe</option>
            <option value="Realizowane">Realizowane</option>
            <option value="Zrealizowane">Zrealizowane</option>
            <option value="Anulowane">Anulowane</option>
        </select>
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Filtruj</button>
    </div>
</form>
