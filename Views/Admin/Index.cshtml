@using projekt_.NET_schronisko.ViewModels
@model AdminDashboardViewModel

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Panel Pracownika</h2>
        </div>
        <div class="card-body">
            <p class="lead">Liczba użytkowników: <strong>@Model.UserCount</strong></p>

            <div class="d-grid gap-2">
                <a href="/Products/Create" class="btn btn-success btn-lg">Dodaj produkt</a>
                <a href="/Animals/Create" class="btn btn-success btn-lg">Dodaj zwierzaka</a>
                <a href="/Orders/Index" class="btn btn-info btn-lg text-white">Przeglądaj zamówienia</a>
                <a href="/UserManagement/Index" class="btn btn-warning btn-lg">Zarządzaj użytkownikami</a>
            </div>
        </div>
    </div>
</div>
