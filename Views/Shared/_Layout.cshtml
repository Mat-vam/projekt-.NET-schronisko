<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - projekt_.NET_schronisko</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/projekt_.NET_schronisko.styles.css" asp-append-version="true" />
    <!-- Link do Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-paw"></i> Schronisko & Sklep
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Strona Główna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Animals" asp-action="Index">Zwierzęta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Sklep</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Prywatność</a>
                        </li>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Pracownik"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Panel Pracownika</a>
                            </li>
                        }
                        <partial name="_LoginPartial" />
                    </ul>

                    @if (User.Identity.IsAuthenticated && User.IsInRole("Klient"))
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Cart")" class="nav-link position-relative">
                                    <i class="fa fa-shopping-cart fa-lg"></i>
                                    <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark">
                                        @ViewData["CartItemCount"]
                                    </span>
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - projekt_.NET_schronisko - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function updateCartCount(count) {
                const counter = document.getElementById('cart-count');
                if (counter) {
                    counter.innerText = count;
                }
            }

            document.querySelectorAll('.add-to-cart-button').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault(); // zapobiega domyślnemu wysłaniu formularza, jeśli jest

                    const productId = this.getAttribute('data-product-id');
                    const quantityInput = document.getElementById('quantity-' + productId);
                    const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

                    fetch('/Cart/AddToCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({
                            productId: productId,
                            quantity: quantity
                        })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.cartItemCount !== undefined) {
                                updateCartCount(data.cartItemCount);
                            }
                        })
                        .catch(error => {
                            console.error('Błąd podczas dodawania do koszyka:', error);
                        });
                });
            });
        });
    </script>


</body>
</html>
