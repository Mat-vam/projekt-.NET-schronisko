@model projekt_.NET_schronisko.Repository.AnimalRepo

@{
    ViewData["Title"] = "Dodaj zwierzaka";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Dodaj nowego zwierzaka</h2>

        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Imię</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Species" class="form-label">Gatunek</label>
                <input asp-for="Species" class="form-control" />
                <span asp-validation-for="Species" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label">Opis</label>
                <input asp-for="Bio" class="form-control" />
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-control">
                    <option value="Adoptowany">Adoptowany</option>
                    <option value="Niezadoptowany">Niezadoptowany</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="Images" class="form-label">Zdjęcia</label>
                <input type="file" name="Images" multiple class="form-control" />
            </div>

            <div class="d-grid mb-3">
                <input type="submit" value="Dodaj" class="btn btn-success p-2" />
            </div>

            <div class="text-center">
                <a asp-action="Index" class="text-decoration-none">Powrót do listy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
