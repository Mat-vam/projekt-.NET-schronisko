@model IEnumerable<projekt_.NET_schronisko.Models.Animal>

@using Microsoft.AspNetCore.Identity
@inject UserManager<Users> UserManager
@inject SignInManager<Users> SignInManager

@{
    ViewData["Title"] = "Zwierzaki";

    bool isWorker = false;
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var roles = await UserManager.GetRolesAsync(user);
        isWorker = roles.Contains("Pracownik");
    }
}
@if (ViewBag.adoptSuccess != null && (bool)ViewBag.adoptSuccess)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        Formularz został złożony pomyślnie.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
    </div>
}
<div class="container">
<h1 class="my-4">Zwierzaki</h1>

@if (isWorker)
{
    <a asp-action="Create" class="btn btn-success mb-4">Dodaj nowego zwierzaka</a>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (item.Images != null && item.Images.Any())
                {
                    <img src="@item.Images.FirstOrDefault()?.ImageUrl" class="card-img-top" alt="Zdjęcie zwierzaka" style="object-fit: cover; height: 200px;">
                }
                else
                {
                    <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        Brak zdjęcia
                    </div>
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text mb-1"><strong>Gatunek:</strong> @item.Species</p>
                    <p class="card-text mb-1"><strong>Status:</strong> @item.Status</p>
                    <p class="card-text text-muted" style="font-size: 0.9rem;">@item.Bio?.Substring(0, Math.Min(item.Bio.Length, 100))...</p>

                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info text-white w-100 mb-2">Szczegóły</a>

                        @if (isWorker)
                        {
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning w-100 mb-2">Edytuj</a>
                            <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger w-100">Usuń</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<hr class="my-5" />

<h4>Filtruj</h4>
<form method="get" class="row g-3">
    <div class="col-md-4">
        <label for="species" class="form-label">Gatunek:</label>
        <select name="species" class="form-select">
            <option value="">Wszystkie</option>
            @foreach (var sp in (List<string>)ViewBag.SpeciesList)
            {
                <option value="@sp">@sp</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label for="adopted" class="form-label">Status adopcji:</label>
        <select name="adopted" class="form-select">
            <option value="">Wszystkie</option>
            <option value="true">Adoptowany</option>
            <option value="false">Niezadoptowany</option>
        </select>
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtruj</button>
    </div>
</form>
</div>