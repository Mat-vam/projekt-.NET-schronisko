@model projekt_.NET_schronisko.Models.Animal
@{
    ViewData["Title"] = "Szczegóły";
    bool isLoggedIn = User.Identity.IsAuthenticated;
}
@{
    var request = new projekt_.NET_schronisko.ViewModels.AdoptionRequestViewModel
            {
                AnimalId = Model.ID,
                FullName = ViewBag.FullName,
                Email = ViewBag.UserEmail
            };
}

<h1 class="mb-4">Szczegóły zwierzaka</h1>

<div class="card shadow-sm">
    <div class="row g-0">
        <div class="col-md-5 d-flex flex-column align-items-center justify-content-center p-3">
            @if (Model.Images != null && Model.Images.Any())
            {
                <img id="currentImage" src="@Model.Images.First().ImageUrl" class="img-fluid rounded mb-2" style="max-height: 300px; object-fit: contain;" alt="Zdjęcie zwierzaka" />

                <div class="btn-group">
                    <button id="prevBtn" class="btn btn-outline-secondary"><i class="bi bi-chevron-left"></i></button>
                    <button id="nextBtn" class="btn btn-outline-secondary"><i class="bi bi-chevron-right"></i></button>
                </div>

                <script>
                    const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Images.Select(i => i.ImageUrl)));
                    let currentIndex = 0;

                    const currentImage = document.getElementById('currentImage');
                    const prevBtn = document.getElementById('prevBtn');
                    const nextBtn = document.getElementById('nextBtn');

                    prevBtn.addEventListener('click', () => {
                        currentIndex = (currentIndex - 1 + images.length) % images.length;
                        currentImage.src = images[currentIndex];
                    });

                    nextBtn.addEventListener('click', () => {
                        currentIndex = (currentIndex + 1) % images.length;
                        currentImage.src = images[currentIndex];
                    });
                </script>
            }
            else
            {
                <div class="text-muted text-center">Brak zdjęć zwierzaka.</div>
            }
        </div>

        <div class="col-md-7">
            <div class="card-body">
                <h3 class="card-title">@Model.Name</h3>
                <p class="card-text"><strong>Gatunek:</strong> @Model.Species</p>
                <p class="card-text"><strong>Opis:</strong> @Model.Bio</p>
                <p class="card-text"><strong>Status:</strong> @Model.Status</p>

                <div class="mt-4">
                    @if (User.IsInRole("Pracownik"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning me-2">Edytuj</a>
                    }
                    else
                    {
                        @if (Model.Status == "Adoptowany")
                        {
                            <div class="alert alert-success">Ten zwierzak już znalazł dom!</div>
                        }
                        else
                        {
                            @if (isLoggedIn)
                            {
                                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#adoptionModal">
                                    Złóż formularz
                                </button>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <a href="/Account/Login" class="btn btn-warning">Zaloguj się</a>
                                    <a href="/Account/Register" class="btn btn-outline-primary">Zarejestruj się</a>
                                </div>
                            }
                        }
                    }
                    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
                </div>
            </div>
        </div>

    </div>
</div>
@if (isLoggedIn)
{
    <div class="modal fade" id="adoptionModal" tabindex="-1" aria-labelledby="adpotionModallLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form id="adoptionForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="adoptionModalLabel">Dane do formularza</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AnimalID" value="@Model.ID" />
                    <div class="mb-2">
                        <input class="form-control" name="FullName" value="@ViewBag.FullName" readonly />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="Email" value="@ViewBag.UserEmail" readonly />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="PostalCode" placeholder="Kod pocztowy" required />
                        <div class="text-danger field-error" data-valmsg-for="PostalCode"></div>
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="City" placeholder="Miasto" required />
                        <div class="text-danger field-error" data-valmsg-for="City"></div>
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="Address" placeholder="Adres" required />
                        <div class="text-danger field-error" data-valmsg-for="Address"></div>
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="PhoneNumber" placeholder="Telefon" required />
                        <div class="text-danger field-error" data-valmsg-for="PhoneNumber"></div>
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control" name="AboutMe" rows="4" placeholder="Opowiedz coś o sobie" required></textarea>
                        <div class="text-danger field-error" data-valmsg-for="AboutMe"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Zatwierdź</button>
                </div>
            </form>
        </div>
    </div>
}
<script>
    document.getElementById("adoptionForm")?.addEventListener("submit", function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        data.AnimalId = parseInt(data.AnimalID);
        delete data.AnimalID;

        fetch("/Animals/SubmitAdoption", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify(data)
        })
            .then(async res => {
                if (!res.ok) throw new Error(await res.text());
                return res.json();
            })
            .then(res => {
                if (res.success) {
                    window.location.href = `/Animals/Index?adoptionSuccess=true`;
                }
            })
            .catch(async err => {
                try {
                    const response = JSON.parse(err.message); 
                    if (response.errors) {
                        document.querySelectorAll(".field-error").forEach(el => el.textContent = "");

                        for (const field in response.errors) {
                            const messages = response.errors[field];
                            const errorContainer = document.querySelector(`[data-valmsg-for="${field}"]`);
                            if (errorContainer) {
                                errorContainer.textContent = messages.join(", ");
                            }
                        }
                    } else {
                        throw new Error("Nieznany format błędu.");
                    }
                } catch {
                    alert("Wystąpił błąd: " + err.message);
                }
            });
    });
</script>
