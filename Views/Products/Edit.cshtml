@model projekt_.NET_schronisko.Repository.ProductRepo

@{
    ViewData["Title"] = "Edytuj produkt";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Edytuj produkt</h2>
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ID" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01"/>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-control">
                    <option value="Zabawka">Zabawka</option>
                    <option value="Karma">Karma</option>
                    <option value="Akcesoria">Akcesoria</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="Images">Dodaj nowe zdjęcia</label>
                <input type="file" name="Images" multiple class="form-control" />
            </div>

            <div class="d-grid mb-3">
                <input type="submit" value="Zapisz zmiany" class="btn btn-warning p-2 text-white" />
            </div>


            <div class="text-center">
                <a asp-action="Index" class="text-decoration-none">Powrót do listy</a>
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
