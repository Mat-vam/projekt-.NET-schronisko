@model projekt_.NET_schronisko.Models.Product


@{
    ViewData["Title"] = "Usuń produkt";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Czy na pewno chcesz usunąć?</h2>

        <div>
            <h4>Produkt do usunięcia:</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Name)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Price)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Price)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Category)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Category)
                </dd>
            </dl>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <input type="submit" value="Usuń" class="btn btn-danger p-2" />
                <a asp-action="Index" class="btn btn-secondary p-2">Powrót do listy</a>
            </div>
        </form>
    </div>
</div>
