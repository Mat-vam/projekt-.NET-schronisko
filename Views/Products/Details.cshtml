@model projekt_.NET_schronisko.Models.Product

@{
    ViewData["Title"] = "Szczegóły";
}

<h1 class="mb-4">Szczegóły produktu</h1>

<div class="card shadow-sm">
    <div class="row g-0">
        <div class="col-md-5 d-flex flex-column align-items-center justify-content-center p-3">
            @if (Model.Images != null && Model.Images.Any())
            {
                <img id="currentImage" src="@Model.Images.First().ImageUrl" class="img-fluid rounded mb-2" style="max-height: 300px; object-fit: contain;" alt="Zdjęcie zwierzaka" />

                <div class="btn-group">
                    <button id="prevBtn" class="btn btn-outline-secondary"><i class="bi bi-chevron-left"></i></button>
                    <button id="nextBtn" class="btn btn-outline-secondary"><i class="bi bi-chevron-right"></i></button>
                </div>

                <script>
                    const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Images.Select(i => i.ImageUrl)));
                    let currentIndex = 0;

                    const currentImage = document.getElementById('currentImage');
                    const prevBtn = document.getElementById('prevBtn');
                    const nextBtn = document.getElementById('nextBtn');

                    prevBtn.addEventListener('click', () => {
                        currentIndex = (currentIndex - 1 + images.length) % images.length;
                        currentImage.src = images[currentIndex];
                    });

                    nextBtn.addEventListener('click', () => {
                        currentIndex = (currentIndex + 1) % images.length;
                        currentImage.src = images[currentIndex];
                    });
                </script>
            }
            else
            {
                <div class="text-muted text-center">Brak zdjęć zwierzaka.</div>
            }
        </div>

        <div class="col-md-7">
            <div class="card-body">
                <h3 class="card-title">@Model.Name</h3>
                <p class="card-text"><strong>Cena:</strong> @Model.Price</p>
                <p class="card-text"><strong>Kategoria:</strong> @Model.Category</p>

                <div class="mt-4">
                    @if (User.IsInRole("Pracownik"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning me-2">Edytuj</a>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
                </div>
            </div>
        </div>

    </div>
</div>
