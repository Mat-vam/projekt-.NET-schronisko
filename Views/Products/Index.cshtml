@model IEnumerable<projekt_.NET_schronisko.Models.Product>

@using Microsoft.AspNetCore.Identity
@inject UserManager<Users> UserManager
@inject SignInManager<Users> SignInManager

@if (ViewBag.OrderSuccess != null && (bool)ViewBag.OrderSuccess)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        Zamówienie zostało złożone pomyślnie.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
    </div>
}


@{
    ViewData["Title"] = "Produkty";

    bool isClient = false;
    bool isEmployee = false;

    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var roles = await UserManager.GetRolesAsync(user);
        isClient = roles.Contains("Klient");
        isEmployee = roles.Contains("Pracownik");
    }
}

<div class="container">
    <h1 class="my-4">Produkty</h1>

    <form id="csrfTokenForm">@Html.AntiForgeryToken()</form>

    @if (isEmployee)
    {
        <a asp-action="Create" class="btn btn-success mb-3">Dodaj nowy produkt</a>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img class="card-img-top" src="@item.Images?.FirstOrDefault()?.ImageUrl" alt="Produkt" style="max-height: 200px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">
                            <strong>Cena:</strong> @item.Price PLN<br />
                            <strong>Kategoria:</strong> @item.Category
                        </p>

                        @if (isClient || !User.Identity.IsAuthenticated)
                        {
                            <div class="d-flex justify-content-between">
                                <input type="number" name="quantity_@item.ID" class="form-control quantity" value="1" min="1" data-product-id="@item.ID" style="width: 80px;" />
                                <button class="btn btn-primary add-to-cart-btn" data-product-id="@item.ID">Dodaj do koszyka</button>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-info btn-sm">Szczegóły</a>

                            @if (isEmployee)
                            {
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning btn-sm">Edytuj</a>
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger btn-sm">Usuń</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <hr class="my-5" />

    <!-- FILTRY POD PRODUKTAMI -->
    <h4>Filtruj</h4>
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label for="category" class="form-label">Kategoria:</label>
            <select name="category" class="form-select">
                <option value="">Wszystkie</option>
                <option value="Zabawka">Zabawka</option>
                <option value="Karma">Karma</option>
                <option value="Akcesoria">Akcesoria</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="sortOrder" class="form-label">Sortuj po cenie:</label>
            <select name="sortOrder" class="form-select">
                <option value="">Domyślnie</option>
                <option value="asc">Od najtańszych</option>
                <option value="desc">Od najdroższych</option>
            </select>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filtruj</button>
        </div>
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".add-to-cart-btn").forEach(button => {
                button.addEventListener("click", function () {
                    const productId = this.dataset.productId;
                    const quantityInput = document.querySelector(`input[data-product-id="${productId}"]`);
                    const quantity = parseInt(quantityInput?.value || "1");

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput?.value;

                    fetch("/Cart/AddToCart", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": token
                        },
                        body: JSON.stringify({
                            productId: productId,
                            quantity: quantity
                        })
                    })
                        .then(response => {
                            if (!response.ok) throw new Error("Błąd dodawania produktu.");
                            return response.json();
                        })
                        .then(data => {
                            const cartCounter = document.getElementById("cartItemCount");
                            if (cartCounter) {
                                cartCounter.innerText = `${data.cartItemCount}`;
                            }

                            const headerCartCounter = document.getElementById("cart-count");
                            if (headerCartCounter) {
                                headerCartCounter.innerText = `${data.cartItemCount}`;
                            }
                        })
                        .catch(error => {
                            console.error("Błąd:", error);
                        });
                });
            });
        });
    </script>
</div>
