@Html.AntiForgeryToken()

@model projekt_.NET_schronisko.Models.Cart

@{
    ViewData["Title"] = "Twój Koszyk";
    bool isLoggedIn = User.Identity.IsAuthenticated;
}

<h2>Twój Koszyk</h2>

@if (Model != null && Model.Items.Any())
{
    <table class="table" id="cartTable">
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Ilość</th>
                <th>Cena</th>
                <th>Całkowita cena</th>
                <th>Akcja</th>
            </tr>
        </thead>
        <tbody id="cartItemsBody">
            @foreach (var item in Model.Items)
            {
                var dataId = isLoggedIn ? item.Id : item.ProductId;

                <tr>
                    <td>@item.Product.Name</td>
                    <td>
                        <input type="number" class="form-control quantity"
                               data-cart-item-id="@dataId"
                               value="@item.Quantity"
                               min="1" />
                    </td>
                    <td>@item.Product.Price.ToString("0.00") zł</td>
                    <td class="total-price">@((item.Quantity * item.Product.Price).ToString("0.00")) zł</td>
                    <td>
                        <button class="btn btn-danger btn-sm remove-item-btn"
                                data-cart-item-id="@dataId">
                            Usuń
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mt-4 gap-3">
        <h4>Łączna cena: <span id="totalPrice">@ViewBag.TotalPrice.ToString("0.00")</span> zł</h4>

        @if (isLoggedIn)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#orderModal">
                Złóż zamówienie
            </button>
        }
        else
        {
            <div class="d-flex gap-2">
                <a href="/Account/Login" class="btn btn-warning">Zaloguj się</a>
                <a href="/Account/Register" class="btn btn-outline-primary">Zarejestruj się</a>
            </div>
        }
    </div>
}
else
{
    <p id="emptyCartMessage">Twój koszyk jest pusty.</p>
}

@if (isLoggedIn)
{
    <!-- Modal zamówienia -->
    <div class="modal fade" id="orderModal" tabindex="-1" aria-labelledby="orderModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form id="orderForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="orderModalLabel">Dane do zamówienia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <div class="mb-2">
                        <input class="form-control" name="FirstName" placeholder="Imię" required />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="LastName" placeholder="Nazwisko" required />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="PostalCode" placeholder="Kod pocztowy" required />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="City" placeholder="Miasto" required />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="Address" placeholder="Adres" required />
                    </div>
                    <div class="mb-2">
                        <input class="form-control" name="PhoneNumber" placeholder="Telefon" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Zatwierdź</button>
                </div>
            </form>
        </div>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".remove-item-btn").forEach(button => {
            button.addEventListener("click", function () {
                const cartItemId = this.dataset.cartItemId;

                fetch("/Cart/RemoveFromCart", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `cartItemId=${cartItemId}`
                })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            alert(data.message || "Coś poszło nie tak.");
                            return;
                        }

                        const row = document.querySelector(`[data-cart-item-id="${cartItemId}"]`)?.closest("tr");
                        if (row) row.remove();

                        document.getElementById("cartItemCount").innerText = data.cartItemCount;
                        document.getElementById("totalPrice").innerText = data.totalPrice;

                        if (data.cartItemCount === 0) {
                            document.getElementById("cartTable").remove();
                            document.getElementById("totalPrice")?.parentElement?.remove();
                            document.querySelector("h2").insertAdjacentHTML("afterend", "<p id='emptyCartMessage'>Twój koszyk jest pusty.</p>");
                        }
                    });
            });
        });

        document.querySelectorAll(".quantity").forEach(input => {
            input.addEventListener("change", function () {
                const cartItemId = this.dataset.cartItemId;
                const quantity = parseInt(this.value) || 1;

                fetch("/Cart/UpdateCartItemQuantity", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `cartItemId=${cartItemId}&quantity=${quantity}`
                })
                    .then(() => {
                        location.reload();
                    });
            });
        });

        document.getElementById("orderForm")?.addEventListener("submit", function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            fetch("/Cart/PlaceOrder", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(data)
            })
                .then(async res => {
                    if (!res.ok) throw new Error(await res.text());
                    return res.json();
                })
                .then(res => {
                    if (res.success) {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('orderModal'));
                        modal.hide();
                        document.querySelector("h2").innerText = "Zamówienie zostało złożone!";
                        document.getElementById("cartTable")?.remove();
                        document.getElementById("totalPrice")?.parentElement?.remove();
                        document.getElementById("orderForm").remove();

                        const button = document.createElement("a");
                        button.href = "/";
                        button.className = "btn btn-primary mt-3";
                        button.innerText = "Powrót na stronę główną";
                        document.querySelector("h2").after(button);
                    }
                })
                .catch(err => {
                    console.error("Błąd:", err.message);
                    alert("Wystąpił błąd: " + err.message);
                });
        });
    });
</script>
