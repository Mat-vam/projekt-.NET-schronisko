@model List<projekt_.NET_schronisko.Models.Orders>
<div class="container">
<h1 class="my-4">Twoje zamówienia</h1>

@if (!Model.Any())
{
        <div class ="alert alert-info text-center mt-4">Nie masz jeszcze żadnych zamówień.</div>
}
else
{
    <div class="info-section">
        <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Suma</th>
                    <th>Produkty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.DataZamowienia.ToString("g")</td>
                        <td>@order.Status</td>
                        <td>@order.TotalAmount zł</td>
                        <td>
                            <ul>
                                @foreach (var item in order.ProduktyZamowienia)
                                {
                                        <a href ="@Url.Action("Details", "Products", new { id = item.ProductId })" class="btn btn-link">@($"{item.Product.Name} (x{@item.Ilosc})")</a>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<form method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label for="sortBy" class="form-label">Sortuj według:</label>
        <select name="sortBy" class="form-select">
            <option value="">Wybierz...</option>
            <option value="date_asc">Data (od najstarszych)</option>
            <option value="date_desc">Data (od najnowszych)</option>
            <option value="total_asc">Suma (rosnąco)</option>
            <option value="total_desc">Suma (malejąco)</option>
        </select>
    </div>

    <div class="col-md-4">
        <label for="statusFilter" class="form-label">Status zamówienia:</label>
        <select name="statusFilter" class="form-select">
            <option value="">Wszystkie</option>
            <option value="Nowe">Nowe</option>
            <option value="Realizowane">Realizowane</option>
            <option value="Zrealizowane">Zrealizowane</option>
            <option value="Anulowane">Anulowane</option>
        </select>
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Filtruj</button>
    </div>
</form>
</div>