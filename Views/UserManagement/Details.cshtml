@model projekt_.NET_schronisko.Models.Users

<div class="container py-5">
    <div class="info-section">
        <h2 class="mb-4">Szczegóły użytkownika</h2>

        <p><strong>Email:</strong> <span class="text-dark">@Model.Email</span></p>
        <p><strong>Imię i nazwisko:</strong> <span class="text-dark">@Model.FullName</span></p>

        <a href="@Url.Action("Index", "UserManagement")" class="btn btn-outline-primary mt-3">
            ← Powrót do listy użytkowników
        </a>
    </div>
</div>